    {
      "name": "Read accepted task ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        0
      ],
      "id": "e214c400-0cea-5a41-bde8-1d1c3d90928d",
      "parameters": {
        "jsCode": "const result = $input.first().json;\nreturn [{json: {\n  taskId: result.taskId ?? null,\n  status: result.status ?? (result.taskId ? 'accepted' : 'unconfirmed'),\n  operationId: $('Review quote').first().json.operationId\n}}];"
      }
    },
