    {
      "name": "Check task state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3040,
        -96
      ],
      "id": "29a0a072-b8e2-51b6-b8c3-84eb6d232852",
      "parameters": {
        "jsCode": "const task = $input.first().json;\nif (typeof task.taskId !== 'string' || !task.taskId) throw new Error('Task response did not include the task ID.');\nconst continuePolling = !['success', 'fail'].includes(task.status) && $runIndex < 23;\nreturn [{json: {...task, continuePolling, operationId: $('Review quote').first().json.operationId }}];"
      }
    },
    {
      "name": "Continue polling?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3296,
        -96
      ],
      "id": "47a6d94e-078a-5275-a26b-b95b811322b2",
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "typeValidation": "strict",
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "1d07310c-9fda-5c6e-a169-d2c2bd244e64",
              "leftValue": "={{ $json.continuePolling }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Return result or recovery details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3552,
        64
      ],
      "id": "be554a49-6fe8-57a0-b5c0-c7c72710483b",
      "parameters": {
        "jsCode": "const { taskId, status, output, lifecycle, operationId, errorCode, error } = $input.first().json;\nreturn [{json: {\n  taskId, status, output, lifecycle, operationId,\n  ...(errorCode ? { errorCode } : {}),\n  ...(error ? { error } : {})\n}}];"
      }
    }
