{
  "id": "i2v-product-image",
  "name": "i2v.ai Product Image",
  "nodes": [
    {
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "5c3ad148-4ec5-53d2-91e3-51782c0473fe",
      "parameters": {}
    },
    {
      "name": "Request and approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        0
      ],
      "id": "3d8371af-ceaf-55e9-a862-cb5e2464b694",
      "parameters": {
        "jsCode": "return [{json: {\n  \"approved\": false,\n  \"maxCostUsd\": \"\",\n  \"operationId\": \"\",\n  \"model\": \"gpt-image-2\",\n  \"prompt\": \"A ceramic mug on an oak table in soft daylight\"\n}}];"
      }
    },
    {
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        0
      ],
      "id": "77c1b854-272f-52dc-9d70-23aea811e99a",
      "parameters": {
        "jsCode": "const { approved, operationId, maxCostUsd, model, prompt, referenceImageUrl } = $input.first().json;\nif (typeof approved !== 'boolean' || typeof prompt !== 'string' || !prompt.trim()) throw new Error('Enter a prompt and an approval setting.');\nif (approved && (!/^[0-9a-zA-Z_-]{10,100}$/.test(operationId) || typeof maxCostUsd !== 'string' || !/^\\d+(\\.\\d{1,8})?$/.test(maxCostUsd))) {\n  throw new Error('For approved generation, use one stable operation ID and an exact USD ceiling.');\n}\nconst inputs = { prompt };\nif (referenceImageUrl) {\n  if (!referenceImageUrl.startsWith('https://')) throw new Error('Use a verified HTTPS reference image URL.');\n  inputs.referenceImageUrls = [referenceImageUrl];\n}\nreturn [{json: { approved, operationId, maxCostUsd, model, inputs }}];"
      }
    },
    {
      "name": "Quote exact inputs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        768,
        0
      ],
      "id": "1afd36e7-beff-5c97-a164-d705732ce609",
      "parameters": {
        "method": "POST",
        "url": "https://api.i2v.ai/api/v1/jobs/quote",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: $json.model, inputs: $json.inputs}) }}"
      },
      "onError": "stopWorkflow"
    },
    {
      "name": "Review quote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        0
      ],
      "id": "bcfefaef-dfe6-5bc7-b8b4-d70b9e29f958",
      "parameters": {
        "jsCode": "const quote = $input.first().json;\nconst config = $('Validate input').first().json;\nconst usd = (value) => {\n  if (typeof value !== 'string' || !/^\\d+(\\.\\d{1,8})?$/.test(value)) throw new Error('Invalid USD quote.');\n  const [whole, fraction = ''] = value.split('.');\n  return BigInt(whole) * 100000000n + BigInt(fraction.padEnd(8, '0'));\n};\nconst maximum = quote.maximum.amount;\nif (!Number.isSafeInteger(quote.expectedRevision) || quote.expectedRevision < 0) throw new Error('The quote is missing the model revision.');\nconst shouldSubmit = config.approved && usd(maximum) <= usd(config.maxCostUsd);\nreturn [{json: {\n  shouldSubmit, maximumUsd: maximum, operationId: config.operationId,\n  status: shouldSubmit ? 'approved' : (config.approved ? 'budget_exceeded' : 'awaiting_approval'),\n  submission: { model: config.model, inputs: config.inputs, maxCostUsd: config.maxCostUsd, expectedRevision: quote.expectedRevision }\n}}];"
      }
    },
    {
      "name": "Within approved USD limit?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1280,
        0
      ],
      "id": "a200e9b3-5707-50a7-ba18-f619a41eb318",
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "typeValidation": "strict",
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "2c3f554d-9e5a-5b40-bb02-3db49a56c2a1",
              "leftValue": "={{ $json.shouldSubmit }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Submit original operation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1536,
        -96
      ],
      "id": "92330025-e8e0-52f9-8d87-f53cb55dad7e",
      "parameters": {
        "method": "POST",
        "url": "https://api.i2v.ai/api/v1/jobs/createTask",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
