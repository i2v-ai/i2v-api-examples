      "id": "657d0b09-2ca1-565f-b02f-c19fbd59cd48",
      "parameters": {
        "method": "GET",
        "url": "=https://api.i2v.ai/api/v1/jobs/recordInfo?taskId={{ encodeURIComponent($json.taskId) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000,
