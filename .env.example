I2V_API_KEY=

# Optional: another environment origin (default is https://api.i2v.ai)
# The scripts append /api/v1 unless the value already ends with it.
# I2V_BASE_URL=https://api.i2v.ai

# Set both after reviewing the quote to submit a paid task.
# Use a new path in a private directory for every logical submission.
# I2V_MAX_COST_USD=
# I2V_RECEIPT_PATH=
# Optional: pin the Idempotency-Key for this logical submission.
# I2V_IDEMPOTENCY_KEY=
